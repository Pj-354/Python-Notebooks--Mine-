    "#Add GDP\n",
    "GDP = df_quarterly['GDP'].copy()\n",
    "GDP.index = pd.to_datetime(GDP.index).to_period('Q')\n",
    "Quarterly_Diff['GDP'] = GDP\n",
    "\n",
    "#Difference\n",
    "Quarterly_Diff = 100* ((Quarterly_Diff / Quarterly_Diff.shift())**4 -1)\n",
    "Quarterly_Diff = Quarterly_Diff.dropna().round(3)"
   ]
  },
