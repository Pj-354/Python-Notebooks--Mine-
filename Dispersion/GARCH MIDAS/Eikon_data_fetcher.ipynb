    "rvol = pd.read_csv('RVol_2005_2025.csv', parse_dates=True).dropna()\n",
    "vix = pd.read_csv('VIX_2005_2025.csv', parse_dates = True)\n",
    "vvix = pd.read_csv('VVIX_2006_2025.csv', parse_dates = True)\n",
