    "def split_into_dict(names : list,\n",
    "                    df_raw_dict : dict):\n",
    "    for i in names:\n",
    "        df = pd.read_csv(f'{i}.csv', parse_dates=True)\n",
    "        df.columns = ['Date', str(i)]\n",
    "        df.set_index('Date', inplace=True)\n",
    "        df_raw_dict[i] = df\n",
    "\n",
    "    return df_raw_dict\n"
   ]
